// Texture loading functions
// Note: These functions require GPU access

pub type Texture2D struct {
    id: usize,
    width: s32,
    height: s32,
    mipmaps: s32,
    format: s32,
}

pub extern C fn LoadTexture as load_texture(*[u8]) Texture2D; 
pub extern C fn UnloadTexture as unload_texture(Texture2D) void; 

// Texture drawing functions
pub extern C fn DrawTexture as draw_texture(Texture2D, s32, s32, Color) void;
