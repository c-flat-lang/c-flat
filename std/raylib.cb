// Wave/Sound loading/unloading functions
type Wave struct {
    frameCount: usize,
    sampleRate: s32,
    sampleSize: s32,
    channels: s32,
    data: *[u8],
}

// HACK: this is just till we can better describe the type in c flat.
// This will not work on native linux right now.
type Sound struct {
    handle: s32,
}

pub extern C fn InitAudioDevice as init_audio_device() void;
pub extern C fn CloseAudioDevice as close_audio_device() void;
pub extern C fn IsAudioDeviceReady as is_audio_device_ready() bool;

pub extern C fn LoadWave as load_wave(*[u8]) Wave;
pub extern C fn LoadWaveFromMemory as load_wave_from_memory(*[u8], *[u8], s32) Wave;
pub extern C fn IsWaveValid as is_wave_valid(Wave) bool;
pub extern C fn LoadSound as load_sound(*[u8]) Sound;
pub extern C fn LoadSoundFromWave as load_sound_from_wave(Wave) Sound;
pub extern C fn LoadSoundAlias as load_sound_alias(Sound) Sound;
pub extern C fn IsSoundValid as is_sound_valid(Sound) bool;
pub extern C fn UpdateSound as update_sound(Sound, *Sound, s32) void;
pub extern C fn UnloadWave as unload_wave(Wave) void;
pub extern C fn UnloadSound as unload_sound(Sound) void;
pub extern C fn UnloadSoundAlias as unload_sound_alias(Sound) void;
pub extern C fn ExportWave as export_wave(Wave, *[u8]) bool;
pub extern C fn ExportWaveAsCode as export_wave_as_code(Wave, *[u8]) bool;

// Music

// HACK: this is just till we can better describe the type in c flat.
// This will not work on native linux right now.
type Music struct {
